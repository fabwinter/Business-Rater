# Copy this file to .env.local for local development.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local — it's already covered by Next.js's default .gitignore.

# Required for provider: "bridge" or "anthropic"
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if you'll select provider: "openai"
OPENAI_API_KEY=sk-...

# Only needed if you'll select provider: "poyo"
POYO_API_KEY=...
